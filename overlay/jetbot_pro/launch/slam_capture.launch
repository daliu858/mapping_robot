<?xml version="1.0"?>
<!-- One physical traversal: gmapping + calibrated stereo + atomic rosbag.

     This formal semantic-map capture path deliberately contains no AMCL,
     move_base or TEB.  Motion comes from a supervised joystick when requested
     or from one external /cmd_vel source.  Offline LLMDet and stereo fusion
     consume the committed bag and final map produced by this launch.
-->
<launch>
  <arg name="bag"/>
  <arg name="map_file"/>
  <arg name="camera_mount"
       doc="measured x y z yaw pitch roll: base_footprint to left optical"/>
  <arg name="base_port" default="/dev/ttyACM0"/>
  <arg name="lidar_port" default="/dev/ttyACM1"/>
  <arg name="left_sensor_id" default="1"/>
  <arg name="right_sensor_id" default="0"/>
  <arg name="start_joystick" default="false"/>
  <arg name="min_free_space_gib" default="2.5"/>
  <arg name="finalize_free_space_gib" default="0.8"/>
  <arg name="max_pair_dt_s" default="0.020"/>
  <arg name="rosbag_stop_timeout_s" default="45.0"/>
  <arg name="left_camera_info_url"
       default="file://$(find jetbot_pro)/config/camera_calibration/stereo_left_640x480.yaml"/>
  <arg name="right_camera_info_url"
       default="file://$(find jetbot_pro)/config/camera_calibration/stereo_right_640x480.yaml"/>

  <include file="$(find jetbot_pro)/launch/slam.launch">
    <arg name="map_type" value="gmapping"/>
    <arg name="base_port" value="$(arg base_port)"/>
    <arg name="lidar_port" value="$(arg lidar_port)"/>
    <arg name="camera_mode" value="stereo"/>
    <arg name="start_camera" value="true"/>
    <arg name="left_sensor_id" value="$(arg left_sensor_id)"/>
    <arg name="right_sensor_id" value="$(arg right_sensor_id)"/>
    <arg name="max_pair_dt_s" value="$(arg max_pair_dt_s)"/>
    <arg name="start_stereo_image_proc" value="false"/>
    <arg name="load_camera_info" value="true"/>
    <arg name="left_camera_info_url" value="$(arg left_camera_info_url)"/>
    <arg name="right_camera_info_url" value="$(arg right_camera_info_url)"/>
  </include>

  <group if="$(arg start_joystick)">
    <include file="$(find jetbot_pro)/launch/joystick_teleop.launch"/>
  </group>

  <node pkg="tf" type="static_transform_publisher"
        name="base_to_stereo_left_optical" required="true"
        args="$(arg camera_mount) base_footprint stereo_left_optical 20"/>

  <node pkg="jetbot_pro" type="checked_slam_capture.py"
        name="slam_capture" output="screen" required="true">
    <param name="bag" value="$(arg bag)"/>
    <param name="map_file" value="$(arg map_file)"/>
    <param name="camera_mount" value="$(arg camera_mount)"/>
    <param name="camera_optical_frame" value="stereo_left_optical"/>
    <param name="min_free_space_gib" value="$(arg min_free_space_gib)"/>
    <param name="finalize_free_space_gib"
           value="$(arg finalize_free_space_gib)"/>
    <param name="max_pair_dt_s" value="$(arg max_pair_dt_s)"/>
    <param name="rosbag_stop_timeout_s"
           value="$(arg rosbag_stop_timeout_s)"/>
    <param name="recording_status_topic"
           value="/survey/recording_status"/>
    <param name="motion_odom_topic" value="/odom_raw"/>
    <param name="topics_csv"
           value="/tf,/tf_static,/scan,/odom,/odom_raw,/survey/map_image_sha256,/survey/map_manifest_sha256,/survey/recording_status,/stereo/left/camera_info,/stereo/right/camera_info,/stereo/left/image_raw/compressed,/stereo/right/image_raw/compressed"/>
    <!-- /map is checked live but deliberately not recorded.  Offline replay
         loads the saved final map through map_server, avoiding two publishers. -->
    <param name="required_topics_csv"
           value="/scan,/odom,/odom_raw,/map,/stereo/left/camera_info,/stereo/right/camera_info,/stereo/left/image_raw/compressed,/stereo/right/image_raw/compressed"/>
  </node>
</launch>
