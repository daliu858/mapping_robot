<?xml version="1.0"?>
<launch>
  <param name="use_sim_time" value="false"/>

  <arg name="map_type" default="gmapping" doc="opt: gmapping,hector,karto,cartographer"/>

  <!-- RViz viewer only. Run slam.launch separately on the robot; this no longer includes it
       (that include was the bug that double-started every node). Teleop: run
       keyboard_teleop.launch or joystick_teleop.launch in another terminal. -->
  <group if="$(eval arg('map_type') != 'cartographer')">
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find jetbot_pro)/rviz/slam.rviz" />
  </group>

  <group if="$(eval arg('map_type') == 'cartographer')">
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find jetbot_pro)/rviz/carto_slam.rviz" />
  </group>
</launch>
