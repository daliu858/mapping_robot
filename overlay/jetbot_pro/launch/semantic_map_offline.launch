<?xml version="1.0"?>
<!-- Offline semantic fusion for an already recorded rosbag.

     Stereo default:
       roslaunch jetbot_pro semantic_map_offline.launch \
         bag:=run1.bag det_file:=detections.json \
         map_file:=/home/jetbot/maps/mymap.yaml \
         output_file:=/home/jetbot/semantic_objects_run1.yaml

     The bag contains compressed raw left/right images.  image_transport
     expands them during replay; stereo_image_proc then publishes disparity.
     detection_publisher republishes offline open-vocabulary boxes at the original left
     image timestamps, and semantic_mapper synchronizes bbox + disparity.

     This formal transactional entry point is stereo-only.  The old monocular
     LiDAR-bearing path is retained inside semantic_mapper for regression, but
     cannot emit a completed release artifact through this launch.
-->
<launch>
  <arg name="bag"/>
  <arg name="det_file"/>
  <!-- Required: provide the occupancy-map YAML matching the recorded run. -->
  <arg name="map_file"/>
  <!-- Required unique output prevents a failed replay from looking successful
       merely because an older semantic_objects.yaml is still present. -->
  <arg name="output_file"/>
  <arg name="max_pair_dt_s" default="0.020"/>
  <arg name="detections_rectified" default="false"/>
  <arg name="motion_odom_topic" default="/odom_raw"/>
  <!-- This Nano produced disparity at about 9-10 Hz while the recorded pair is
       30 Hz.  Slow replay keeps every detector stride frame eligible for
       exact-timestamp disparity instead of dropping most detections. -->
  <arg name="play_rate" default="0.25"/>
  <arg name="finalize_timeout_s" default="120.0"/>
  <arg name="img_topic" default="/stereo/left/image_raw/compressed"/>
  <arg name="left_image_base" default="/stereo/left/image_raw"/>
  <arg name="right_image_base" default="/stereo/right/image_raw"/>
  <arg name="camera_info_topic" default="/stereo/left/camera_info"/>
  <arg name="disparity_topic" default="/stereo/disparity"/>
  <!-- Real IMX219-83 near-field testing found the upstream default of 64
       disparities excluded useful targets below about 0.84 m. -->
  <arg name="disparity_range" default="128"/>
  <!-- _19 live replay measured 2213/307200 (0.7 percent) positive disparity
       pixels; every other finite pixel was the block matcher's -1 no-match
       marker.  The 1.49x rectification zoom (raw_fx 594.2 -> rect_fx 884.9)
       plus the JPEG republish smooths texture below the stock admission
       thresholds, so nearly every correlation window is rejected before it
       is ever matched.  These settings admit weak indoor texture; the
       mapper's median/IQR/near-cluster and the map/spread gates keep the
       quality decision downstream.
         prefilter_cap 63: strongest contrast normalization for washed-out
           rectified images (upstream default 31).
         texture_threshold 2: the threshold applies to prefiltered gradient
           sums, which the zoom interpolation shrinks; 10 rejected almost
           every low-texture indoor window.
         uniqueness_ratio 8: blurred correlation surfaces are flat; a 15
           percent winner margin almost never exists indoors.
         correlation_window_size 21: integrate weak texture over a larger
           support; smearing frame-edge disparity a few pixels into the
           door panel is correct here because the frame IS the door plane.
         speckle_size/speckle_range: upstream defaults, exposed for the
           on-robot tuning pass only.  min_disparity stays 0. -->
  <arg name="prefilter_cap" default="63"/>
  <arg name="texture_threshold" default="2"/>
  <arg name="uniqueness_ratio" default="8"/>
  <arg name="correlation_window_size" default="21"/>
  <arg name="speckle_size" default="100"/>
  <arg name="speckle_range" default="4"/>
  <arg name="min_disparity" default="0"/>
  <!-- A door bbox center is the panel: textureless when closed, the next
       room when open.  Surviving disparity concentrates on the frame edges
       at the bbox border, so when the 40 percent center ROI is starved the
       mapper widens sampling to the full rectified bbox.  The near-cluster
       depth selector still refuses to jump through an open doorway. -->
  <arg name="depth_roi_expand" default="true"/>
  <!-- _19 full-bag: 631 of 834 gated door boxes were one persistent
       ~86x41 px bottom-left detector sliver (median center x=65) firing in
       132-frame streaks: the robot's own near field, not a door.  Its
       floor points fed map_reject and chained into association smears that
       absorbed real door hits (confirmed=0 despite stereo_ok=98).  Real
       doors sat at 120 px height and above (histogram valley 100-119).
       120 raw px is also the pixel image of the existing 10 m depth_max
       gate: a full 2 m door at 10 m subtends ~179 rect px = ~120 raw px,
       so this admits every door the depth gate could ever accept. -->
  <arg name="min_structure_bbox_h_px" default="120"/>
  <!-- r3: 39 of 67 valid door depths (58 percent) failed the
       near-occupied check at 0.30 m.  An OPEN door's bbox is the doorway;
       its center bearing lands mid-gap, and the gap is free by
       definition.  Gap-center to jamb in a ~0.9 m doorway is 0.40-0.45 m,
       so 0.30 systematically rejects open doors while closed doors (leaf
       mapped as wall) pass.  0.45 reaches a jamb from anywhere inside a
       standard doorway; deep next-room points still fail. -->
  <arg name="occupied_radius_m" default="0.45"/>
  <arg name="optical_frame" default="stereo_left_optical"/>
  <!-- Bounded TF replay slip: a detection stamped a few ms ahead of the
       buffered map chain uses the newest transform instead of dropping.
       Misses beyond this bound drop that one frame, never the whole bag.
       0.25 held through r3 while valid-rate was the bottleneck; with the
       geometry pipeline at 81 percent valid, the binding cost became the
       443 dropped frames (23 percent, incl. door approaches).  0.40 at
       the <=0.30 m/s motion gate bounds the extra error at ~12 cm, inside
       the 0.25 m spread budget. -->
  <arg name="tf_future_tolerance_s" default="0.40"/>
  <!-- The Nano computes disparity at 9-10 Hz against the 7.5 Hz replayed
       pair; a transient hiccup can drop an exact-stamp pairing forever.
       Tolerate this bounded fraction of unsynced detector frames at
       finalize instead of timing out with no yaml.  The actual shortfall
       is recorded in the yaml provenance (stats.sync_missing). -->
  <arg name="max_unsynced_fraction" default="0.05"/>
  <!-- One random value is shared only by this mapper and replay runner. -->
  <arg name="transaction_token" default="$(anon semantic_transaction)"/>
  <!-- Household demo default remains chair,table,door.  The AMCL door
       placement trial overrides this to door with the detector poi-set door.
       Fusion is fail-closed on this trial: doors must sit on occupied
       structure, stay inside 0.25 m spread, and beat score_min 0.40.
       _19 LLMDet scores sit around 0.40 (only 9 boxes >=0.50); 0.50 would
       make fusion vacuously empty and not exercise the geometric gates. -->
  <arg name="required_labels_csv" default="chair,table,door"/>
  <!-- Default 0.25 is the r4 compactness gate.  _20 two 7-hit door tracks
       printed spread=0.25 / 0.28 and died (std() > 0.25).  Tonight's
       replay may pass 0.30 without changing the default. -->
  <arg name="max_spread_m" default="0.25"/>
  <arg name="min_hits" default="5"/>

  <param name="/use_sim_time" value="true"/>

  <node pkg="map_server" type="map_server" name="map_server" required="true"
        args="$(arg map_file)"/>

  <!-- A recorded compressed transport must be republished as sensor_msgs/Image
       before stereo_image_proc can rectify and match the pair. -->
  <group>
    <node pkg="image_transport" type="republish" name="left_decompress"
          args="compressed in:=$(arg left_image_base) raw out:=$(arg left_image_base)"
          required="true"/>
    <node pkg="image_transport" type="republish" name="right_decompress"
          args="compressed in:=$(arg right_image_base) raw out:=$(arg right_image_base)"
          required="true"/>
    <group ns="stereo">
      <node pkg="jetbot_pro" type="stereo_pair_gate.py"
            name="stereo_pair_gate" output="screen" required="true">
        <param name="max_pair_dt_s" value="$(arg max_pair_dt_s)"/>
        <param name="queue_size" value="30"/>
        <param name="require_calibration" value="true"/>
      </node>
      <node pkg="stereo_image_proc" type="stereo_image_proc"
            name="stereo_image_proc" output="screen" required="true">
        <remap from="left/image_raw" to="left/image_sync"/>
        <remap from="left/camera_info" to="left/camera_info_sync"/>
        <remap from="right/image_raw" to="right/image_sync"/>
        <remap from="right/camera_info" to="right/camera_info_sync"/>
        <param name="approximate_sync" value="false"/>
        <param name="queue_size" value="30"/>
        <param name="disparity_range" value="$(arg disparity_range)"/>
        <param name="prefilter_cap" value="$(arg prefilter_cap)"/>
        <param name="texture_threshold" value="$(arg texture_threshold)"/>
        <param name="uniqueness_ratio" value="$(arg uniqueness_ratio)"/>
        <param name="correlation_window_size"
               value="$(arg correlation_window_size)"/>
        <param name="speckle_size" value="$(arg speckle_size)"/>
        <param name="speckle_range" value="$(arg speckle_range)"/>
        <param name="min_disparity" value="$(arg min_disparity)"/>
      </node>
    </group>
  </group>

  <node pkg="jetbot_pro" type="detection_publisher.py"
        name="detection_publisher" output="screen" required="true">
    <param name="det_file" value="$(arg det_file)"/>
    <param name="bag" value="$(arg bag)"/>
    <param name="image_topic" value="$(arg img_topic)"/>
    <param name="compressed" value="true"/>
    <param name="optical_frame" value="$(arg optical_frame)"/>
    <param name="detections_rectified" value="$(arg detections_rectified)"/>
    <param name="require_exact_timestamps" value="true"/>
    <remap from="detections" to="/detectnet/detections"/>
    <remap from="vision_info" to="/detectnet/vision_info"/>
  </node>

  <node pkg="jetbot_pro" type="semantic_mapper.py"
        name="semantic_mapper" output="screen" required="true">
    <remap from="detections" to="/detectnet/detections"/>
    <remap from="vision_info" to="/detectnet/vision_info"/>
    <remap from="camera_info" to="$(arg camera_info_topic)"/>
    <remap from="disparity" to="$(arg disparity_topic)"/>
    <remap from="scan" to="/scan"/>
    <remap from="odom" to="$(arg motion_odom_topic)"/>
    <remap from="map" to="/map"/>
    <param name="range_source" value="stereo"/>
    <param name="detections_rectified" value="$(arg detections_rectified)"/>
    <param name="require_detection_camera_stamp" value="true"/>
    <param name="score_min" value="0.40"/>
    <param name="max_bearing_deg" value="40.0"/>
    <param name="min_hits" value="$(arg min_hits)"/>
    <param name="max_spread_m" value="$(arg max_spread_m)"/>
    <param name="structure_labels_csv" value="door"/>
    <param name="occupied_radius_m" value="$(arg occupied_radius_m)"/>
    <param name="depth_roi_scale" value="0.40"/>
    <param name="depth_roi_expand" value="$(arg depth_roi_expand)"/>
    <param name="min_structure_bbox_h_px"
           value="$(arg min_structure_bbox_h_px)"/>
    <param name="depth_min_m" value="0.30"/>
    <param name="depth_max_m" value="10.0"/>
    <param name="depth_iqr_max_m" value="1.50"/>
    <param name="stereo_lidar_fallback" value="false"/>
    <param name="save_path" value="$(arg output_file)"/>
    <param name="source_bag" value="$(arg bag)"/>
    <param name="detections_file" value="$(arg det_file)"/>
    <param name="map_file" value="$(arg map_file)"/>
    <param name="require_map_identity" value="true"/>
    <param name="map_identity_topic" value="/survey/map_image_sha256"/>
    <param name="map_manifest_identity_topic"
           value="/survey/map_manifest_sha256"/>
    <param name="required_labels_csv"
           value="$(arg required_labels_csv)"/>
    <param name="transactional_finalize_only" value="true"/>
    <param name="pipeline_quiet_s" value="1.0"/>
    <param name="max_unsynced_fraction" value="$(arg max_unsynced_fraction)"/>
    <param name="require_map_received" value="true"/>
    <!-- With /use_sim_time, a positive TF timeout can never expire after the
         final /clock message.  Offline replay therefore performs a nonblocking
         exact-time lookup.  A miss costs only that frame: bag-open gaps and
         bounded future slip (tf_future_tolerance_s) never INVALID the bag. -->
    <param name="tf_lookup_timeout_s" value="0.0"/>
    <param name="tf_future_tolerance_s" value="$(arg tf_future_tolerance_s)"/>
    <param name="finalize_token" value="$(arg transaction_token)"/>
  </node>

  <!-- Own rosbag play so end-of-bag becomes a checked transaction: drain the
       last stereo callbacks, call mapper/finalize, and exit nonzero when no
       confirmed object was produced. -->
  <node pkg="jetbot_pro"
        type="offline_replay_runner.py" name="offline_replay_runner"
        output="screen" required="true">
    <param name="bag" value="$(arg bag)"/>
    <param name="detections_file" value="$(arg det_file)"/>
    <param name="map_file" value="$(arg map_file)"/>
    <param name="rate" value="$(arg play_rate)"/>
    <param name="finalize_timeout_s" value="$(arg finalize_timeout_s)"/>
    <param name="range_source" value="stereo"/>
    <param name="img_topic" value="$(arg img_topic)"/>
    <param name="left_image_base" value="$(arg left_image_base)"/>
    <param name="right_image_base" value="$(arg right_image_base)"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)"/>
    <param name="disparity_topic" value="$(arg disparity_topic)"/>
    <param name="optical_frame" value="$(arg optical_frame)"/>
    <param name="detections_rectified" value="$(arg detections_rectified)"/>
    <param name="stereo_lidar_fallback" value="false"/>
    <param name="finalize_service" value="/semantic_mapper/finalize"/>
    <param name="finalize_token" value="$(arg transaction_token)"/>
    <param name="require_complete_marker" value="true"/>
    <param name="recording_status_topic" value="/survey/recording_status"/>
    <param name="detection_ready_service"
           value="/detection_publisher/ready"/>
    <param name="detection_complete_service"
           value="/detection_publisher/complete_input"/>
    <!-- Polled during rosbag play: a locked INVALID stops the replay now
         instead of playing a doomed bag to the end (bag 19 burned ~90 min
         after an 8-second-mark INVALID). -->
    <param name="pipeline_status_service"
           value="/semantic_mapper/pipeline_status"/>
  </node>
</launch>
