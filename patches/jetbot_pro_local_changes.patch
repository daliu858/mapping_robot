-# max_vel_x: 0.7
- max_vel_x_backwards: 0.35
- max_vel_theta: 2.5
-# max_vel_theta: 1.5
- acc_lim_x: 1.20
- acc_lim_theta: 1.5
+ # Conservative indoor exploration limits for the real JetBot.  The original
+ # 0.7 m/s / 2.5 rad/s values are too aggressive around furniture and doors.
+ max_vel_x: 0.18
+ max_vel_x_backwards: 0.12
+ # In-place spinning was the 8/4 AMCL second-pass failure mode.  Keep yaw
+ # slow enough that a rejected TEB plan cannot whip the chassis around.
+ max_vel_theta: 0.40
