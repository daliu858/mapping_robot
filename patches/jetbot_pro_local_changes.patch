    #vertices: [[-0.12, -0.12], [-0.12, 0.12],[0.12, 0.12], [0.12, -0.12]]
    #vertices: [[-0.1, -0.26], [-0.1, 0.26],[0.287, 0.26], [0.287, -0.26]]
 
@@ -37,9 +48,24 @@ TebLocalPlannerROS:
 
  # Obstacles
 
- min_obstacle_dist: 0.20
+ # min_obstacle_dist is a SOFT margin between the 0.14 m circular footprint
+ # edge and obstacles (g2o penalty with penalty_epsilon 0.1, weight_obstacle
+ # 50) -- it is not a hard clearance.  Robot diameter is 0.28 m and the
+ # measured north doorway is 0.29--0.32 m wide, so the physical per-side gap
+ # is 0.005--0.02 m.  A 0.12 m margin would demand a 0.14+0.12=0.26 m
+ # centreline clearance, i.e. a >=0.52 m doorway: mathematically impossible
+ # here and one driver of the 8/27 "valid control could not be found" streak.
+ # 0.05 keeps the doorway penalty small enough to optimize through while the
+ # hard collision check stays with the 0.14 m footprint itself.
