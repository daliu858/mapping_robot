diff --git a/config/diff/global_costmap_params.yaml b/config/diff/global_costmap_params.yaml
index ed15250..7b016cc 100755
--- a/config/diff/global_costmap_params.yaml
+++ b/config/diff/global_costmap_params.yaml
@@ -3,11 +3,25 @@ global_costmap:
    robot_base_frame: base_footprint
    update_frequency: 1.5
    publish_frequency: 1.0
-   static_map: true
    rolling_window: false
    resolution: 0.05
    transform_tolerance: 1.2
-   map_type: costmap
+   # DELIBERATE override of the physical 0.14 m radius (costmap_common).
+   # Start pose sits ~7 cm from a mapped obstacle (map res 0.05).  costmap_2d
+   # marks every cell closer than robot_radius to an obstacle INSCRIBED (253)
+   # and global_planner treats 253 as impassable.  With 0.14 the start cell's
+   # neighbours at 0.05/0.10 m all sit inside the 253 band, so no plan can
+   # ever leave the pocket; with 0.12 the first cell 0.12 m out is passable.
+   # This trades planner optimism for escape ability -- the LOCAL costmap and
+   # TEB keep the true 0.14 m footprint, so execution stays physical.
+   robot_radius: 0.12
+   plugins:
+     - {name: static_layer, type: "costmap_2d::StaticLayer"}
+     - {name: inflation_layer, type: "costmap_2d::InflationLayer"}
+   inflation_layer:
+      inflation_radius: 0.10
+      cost_scaling_factor: 2.5
 
 GlobalPlanner:        
-   allow_unknown:  true
+   allow_unknown:  false
+   default_tolerance: 0.50
